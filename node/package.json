{
  "name": "@ileva/sdk-api-v3-auth",
  "version": "0.0.0-development",
  "description": "Autenticação na API Ileva v3: gera o token de acesso e mantém sua validade, com cache compartilhado em Redis.",
  "license": "MIT",
  "keywords": [
    "ileva",
    "oauth",
    "token",
    "redis",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/ileva-sdk-api-v3-auth.test.ts test/http-clients.test.ts test/redis-token-store.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE','LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "axios": "^1.20.0",
    "ioredis": "^5.4.0",
    "redis": "^4.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
